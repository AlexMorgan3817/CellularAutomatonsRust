{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell", "command": "cargo",
			"args": ["build", "--release", "--features", "cli"],
			"problemMatcher": ["$rustc"],
			"group": "build", "label": "Build CLI Release"
		},
		{
			"type": "shell", "command": "cargo",
			"args": ["build","--lib", "--release", "--no-default-features"],
			"problemMatcher": ["$rustc"],
			"group": "build", "label": "Build LIB Release"
		},
		{
			"type": "shell", "command": "cargo",
			"args": ["test", "--release", "--all", "--", "--nocapture", "--test-threads=1"],
			"problemMatcher": ["$rustc"],
			"group": "build", "label": "Test Release"
		},
		{
			"type": "shell",
			"command": "cargo run --release -- 100 100 -s 100 -p 55.0 webp",
			"problemMatcher": ["$rustc"],
			"group": "build", "label": "Run WebP Test"
		},
		{
			"type": "shell",
			"command": "cargo run --release -- 100 100 -s 1000 res -o result/out.frame",
			"problemMatcher": ["$rustc"],
			"group": "build", "label": "Run Res Test"
		},
		{
			"type": "shell",
			"command": "cargo run --release -- 100 20 -s 1000 -p 25 animated -d 100",
			"problemMatcher": ["$rustc"],
			"group": "build", "label": "Run Animated Test"
		}
	]
}
